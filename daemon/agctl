#!/bin/bash
# AmneziaGuard — управление (нужны права администратора).
#   agctl on            — включить защиту (трафик только через Amnezia)
#   agctl off           — выключить защиту (аварийно вернуть обычный интернет)
#   agctl off 15        — выключить на 15 минут, потом включится сама
#   agctl status        — показать состояние
#   agctl allow <IP>    — вручную добавить IP сервера Amnezia
#   agctl forget        — забыть выученные серверы
AG_DIR="/Library/Application Support/AmneziaGuard"
ANCHOR="com.apple/000.AmneziaGuard"
PATH=/usr/bin:/bin:/usr/sbin:/sbin

need_root() { [ "$(id -u)" = 0 ] || { echo "Нужны права: sudo \"$0\" $*"; exit 1; }; }
poke() { pkill -HUP -f "$AG_DIR/guard.sh" 2>/dev/null; }

case "$1" in
  on)  need_root on; rm -f "$AG_DIR/reenable_at"; echo 1 > "$AG_DIR/enabled"; poke
       echo "Защита ВКЛЮЧЕНА" ;;
  off) need_root off
       if [[ "${2:-}" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ]; then
         echo $(( $(date +%s) + $2 * 60 )) > "$AG_DIR/reenable_at"
         msg="на $2 мин — потом включится сама"
       else
         rm -f "$AG_DIR/reenable_at"; msg="до ручного включения"
       fi
       echo 0 > "$AG_DIR/enabled"
       pfctl -a "$ANCHOR" -F all >/dev/null 2>&1; poke
       echo "Защита ВЫКЛЮЧЕНА $msg — интернет работает и без VPN" ;;
  allow)
       need_root allow
       echo "$2" | grep -qE '^([0-9]{1,3}(\.[0-9]{1,3}){3}|[0-9a-fA-F]*:[0-9a-fA-F:.]*)(/[0-9]{1,3})?$' || { echo "Укажите IP: agctl allow 1.2.3.4"; exit 1; }
       echo "$2" >> "$AG_DIR/servers.txt"; poke; echo "Добавлен сервер $2" ;;
  forget)
       need_root forget; : > "$AG_DIR/servers.txt"; poke; echo "Список серверов очищен" ;;
  status|"")
       cat "$AG_DIR/status.json" 2>/dev/null || echo "status.json нет — служба не запущена?"
       echo; [ "$(id -u)" = 0 ] && pfctl -a "$ANCHOR" -sr 2>/dev/null ;;
  *) sed -n '2,8p' "$0"; exit 1 ;;
esac
