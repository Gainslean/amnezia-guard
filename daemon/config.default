# AmneziaGuard — настройки. После правки служба подхватит их сама за 2 секунды.

# 1 — разрешить локальную сеть (принтер, AirDrop, NAS). DNS роутера всё равно закрыт.
# 0 — полностью закрыть и локальную сеть.
ALLOW_LAN=1

# 1 — пускать мимо VPN адреса, которые сама Amnezia исключает (раздельное туннелирование).
# 0 — строго: ничего мимо Amnezia (исключённые сайты перестанут открываться).
ALLOW_SPLIT=0

# Доп. IP серверов Amnezia через пробел (если сервер не выучился сам).
EXTRA_ALLOW=""

# По каким процессам узнавать Amnezia (regex для pgrep -f).
PROC_PATTERN='AmneziaVPNNetworkExtension|AmneziaVPN-service|amneziawg-go'
